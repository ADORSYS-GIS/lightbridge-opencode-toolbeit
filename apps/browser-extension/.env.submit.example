# Store-submission credentials for `wxt submit` (used by the submit:chrome /
# submit:firefox scripts). Copy to `.env.submit` and fill in — `.env.submit` is
# gitignored. In CI these are GitHub repository secrets, not this file.
#
# Each store is independent: fill only the block you've set up. See
# docs/browser.md → "Publishing the extension to the web stores".

# --- Chrome Web Store (API v2, service account) -----------------------------
# Item ID + publisher ID from the Developer Dashboard, and a Google Cloud
# service account granted access to that publisher (client_email/private_key
# from its JSON key). See docs/browser.md → "Publishing the extension to the
# web stores" and https://developer.chrome.com/docs/webstore/service-accounts.
# ⚠️ Keep CHROME_SERVICE_ACCOUNT_PRIVATE_KEY's "\n" as literal backslash-n
# characters, not real newlines, when pasting the JSON's private_key value.
CHROME_API_VERSION=v2
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Firefox Add-ons (AMO) --------------------------------------------------
# Add-on UUID (gecko.id) + API key pair from
# https://addons.mozilla.org/developers/addon/api/key/
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
